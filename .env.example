PORT=3000
NODE_ENV=development
BASE_URL=https://test.trapiseth.site

# Meta App Credentials (from Meta Developer Portal)
APP_SECRET=your_meta_app_secret_here
APP_SESSION_TOKEN=your_meta_page_access_token_here
VERIFY_TOKEN=jewelry_secret_webhook_token_2026

# Admin Panel
ADMIN_PASSWORD=your_secure_admin_password_here

# Telegram Bot — get token from @BotFather, chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_OWNER_CHAT_ID=your_numeric_telegram_user_id_here
TELEGRAM_OWNER_CHAT_ID_2=optional_second_owner_user_id_here
# Supports multiple owners: TELEGRAM_OWNER_CHAT_ID_3, TELEGRAM_OWNER_CHAT_ID_4, etc., or comma-separated IDs

# Outbound Rate Limiting (500-1000ms delay between outbound Messenger messages)
MESSENGER_RATE_LIMIT_MS=800

# Bakong live payment integration (optional: leave false until merchant setup is complete)
BAKONG_ENABLED=false
BAKONG_API_URL=https://api.example-bakong.com
BAKONG_API_TOKEN=your_bakong_api_token_here
BAKONG_MERCHANT_ID=your_bakong_merchant_id_here
BAKONG_WEBHOOK_SECRET=your_bakong_webhook_secret_here
BAKONG_CALLBACK_URL=https://your-domain.com/api/bakong/webhook
