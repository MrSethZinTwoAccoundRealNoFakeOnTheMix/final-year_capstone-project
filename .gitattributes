# Normalize line endings to LF in the repository
* text=auto eol=lf

# Force LF for scripts that run on Linux server
*.js    text eol=lf
*.json  text eol=lf
*.sql   text eol=lf
*.md    text eol=lf
*.env*  text eol=lf

# Binary files — no line ending conversion
*.webp  binary
*.jpg   binary
*.png   binary
*.db    binary
